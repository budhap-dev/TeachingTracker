{
    "name": "teaching-tracker",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "version:patch": "npm version patch --no-git-tag-version",
        "version:minor": "npm version minor --no-git-tag-version",
        "version:major": "npm version major --no-git-tag-version",
        "release": "npm run version:patch && npm run build"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "dependencies": {
        "@azure/msal-browser": "^5.25.0",
        "@azure/msal-react": "^5.7.2",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/caveat": "^5.3.0",
        "@mui/icons-material": "^9.5.0",
        "@mui/material": "^9.2.0",
        "@reduxjs/toolkit": "^2.13.0",
        "@tiptap/react": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-easy-crop": "^6.2.4",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.18.4",
        "redux-saga": "^1.5.1",
        "sass": "^1.105.1",
        "tiptap-markdown": "^0.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.1",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "prettier": "3.9.10",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^5.4.10",
        "vitest": "^5.0.3"
    }
}
